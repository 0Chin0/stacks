+    def retry_all_failed(self):
+        """
+        Retry ALL failed downloads by removing them from history
+        and re-adding them to the queue.
+
+        Originally only a single-item retry existed (retry_failed).
+        This method handles bulk retry in one pass.
+
+        Returns:
+            Tuple of (success: bool, message: str, count: int)
+        """
+        with self.lock:
+            # Collect all failed items
+            failed_items = [
+                item for item in self.history
+                if not item.get('success', False)
+            ]
+            count = len(failed_items)
+
+            if count == 0:
+                return True, "No failed downloads to retry", 0
+
+            # Remove all failed items from history and add to queue
+            failed_md5s = {item['md5'] for item in failed_items}
+            self.history = [
+                item for item in self.history
+                if item['md5'] not in failed_md5s
+            ]
+
+            for item in failed_items:
+                new_item = {
+                    'md5': item['md5'],
+                    'source': 'retry',
+                    'added_at': datetime.now().isoformat(),
+                    'status': 'queued',
+                    'subfolder': item.get('subfolder')
+                }
+                self.queue.append(new_item)
+
+            self.save()
+            self.logger.info(f"Retrying all failed downloads: {count} item(s)")
+            return True, f"Retrying {count} failed download(s)", count
+
